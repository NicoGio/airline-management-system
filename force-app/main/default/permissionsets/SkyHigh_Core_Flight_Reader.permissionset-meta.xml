    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Flight_Segment__c.Origin_Airport__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Flight_Segment__c.Seat_Map_JSON__c</field>
        <readable>true</readable>
    </fieldPermissions>

