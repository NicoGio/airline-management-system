    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>Agentforce_API_Gateway-Agentforce_Principal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
