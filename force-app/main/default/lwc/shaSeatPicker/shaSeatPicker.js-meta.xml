<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>SkyHigh Flight Seat Picker</masterLabel>
    <description>Omni-channel immersive seat selector for travelers and internal agents.</description>
    
    <targets>
        <!-- Experience Cloud / Portal Targets -->
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        
        <!-- Salesforce Core / Lightning Experience Targets -->
        <target>lightning__RecordPage</target>
    </targets>

    <targetConfigs>
        <!-- Experience Cloud Configuration -->
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Flight Segment ID" description="Provide the unique identifier for the flight segment record."/>
        </targetConfig>

        <!-- Salesforce Core Layout Constraints (Restricted to Flight Segment Object) -->
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Flight_Segment__c</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>